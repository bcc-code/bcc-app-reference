{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(pnpm --dir frontend run *)",
      "Bash(aspire describe *)",
      "WebFetch(domain:wolverinefx.net)",
      "WebFetch(domain:aspire.dev)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/worktree-cleanup/prune-volumes.mjs\" --dry-run",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/cloud-session/non-developer.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/cloud-session/prepare.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
