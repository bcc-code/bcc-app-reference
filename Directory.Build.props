<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Analyzer and code style rules fail the build; severities for individual rules are in .editorconfig. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unnecessary using) only runs in the build when the XML documentation file is generated. Doc comments are
         not required on every public member, so CS1591 is off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- The Aspire SDK adds packages for the host OS (Aspire.Dashboard.Sdk.<rid>), so a lock file for the AppHost, or for the E2E tests
       that reference it, cannot match on both Windows and the Linux runners. Neither is deployed. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'AppHost' or '$(MSBuildProjectName)' == 'BccCode.Template.E2eTests'">
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CI)' == 'true' or '$(ContinuousIntegrationBuild)' == 'true'">
    <!-- CI (GitHub Actions sets CI=true) restores exactly what packages.lock.json says. -->
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
</Project>
