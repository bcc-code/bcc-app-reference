<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Transitive pins: a package that no project references directly may only be pinned here with a reason that cites the
       advisory (GHSA/CVE id from NU1901-NU1904), bug or version conflict, and names the chain that pulls it in.
       None at the moment (Aspire 17 requires MessagePack 2.5.307 itself). -->
  <ItemGroup Label="Critter stack (one Wolverine version)">
    <PackageVersion Include="WolverineFx" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.64.2" />
    <PackageVersion Include="WolverineFx.Http.FluentValidation" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Pubsub" Version="6.64.2" />
    <PackageVersion Include="WolverineFx.Pubsub.Http" Version="6.64.2" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.64.2" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.64.2" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.64.2" />
  </ItemGroup>
  <!-- why: EF Core stays on 10.0.x. EF Core 11 waits for Npgsql.EntityFrameworkCore.PostgreSQL 11 and EFCore.NamingConventions 11,
       and WolverineFx.EntityFrameworkCore is built on EF Core 10. -->
  <ItemGroup Label="EF Core (dotnet-ef in .config/dotnet-tools.json is the same version)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup Label="GCP">
    <PackageVersion Include="Google.Cloud.Kms.V1" Version="3.27.0" />
    <PackageVersion Include="Google.Cloud.Logging.Console" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup Label="Web">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <!-- Pinned to 2.x: Microsoft.AspNetCore.OpenApi 10.0.x is built against Microsoft.OpenApi 2.x.
         3.x makes IOpenApiMediaType.Example read-only, breaking the AspNetCore OpenAPI source generator. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.1" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="BCC PubSub transport (standard 13, integration events)">
    <PackageVersion Include="BccCode.PubSub.Wolverine" Version="1.0.49" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="OIDC mock (local only)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.9.0" />
  </ItemGroup>
  <ItemGroup Label="Telemetry">
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageVersion Include="Aspire.Npgsql" Version="17.0.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.PostgreSQL.Extensions" Version="17.0.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- TRX results for the CI failure upload (standard 05.8); same version as the Microsoft.Testing.Platform that xunit.v3 brings. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Alba" Version="9.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="17.0.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
  </ItemGroup>
</Project>
