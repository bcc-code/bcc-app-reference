<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Transitive-only pins exist only to lift a vulnerable transitive version reported as NU1901-NU1904. Each one cites
       the advisory and the package that pulls it in. -->
  <ItemGroup Label="Transitive pins (Aspire.Hosting and StreamJsonRpc depend on MessagePack 2.5.302, which has GHSA-qhrr-8q5h-9q3h; 2.5.303 is the first patched version)">
    <PackageVersion Include="MessagePack" Version="2.5.303" />
  </ItemGroup>
  <ItemGroup Label="Critter stack (one Wolverine version)">
    <PackageVersion Include="Marten" Version="9.50.3" />
    <PackageVersion Include="WolverineFx" Version="6.51.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.51.0" />
    <PackageVersion Include="WolverineFx.Pubsub" Version="6.51.0" />
    <PackageVersion Include="WolverineFx.Pubsub.Http" Version="6.51.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.51.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.51.0" />
    <PackageVersion Include="WolverineFx.Http.Marten" Version="6.51.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.51.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.51.0" />
  </ItemGroup>
  <ItemGroup Label="EF Core (the EfCore variant; dotnet-ef in .config/dotnet-tools.json is the same version)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup Label="GCP">
    <PackageVersion Include="Google.Cloud.Kms.V1" Version="3.27.0" />
    <PackageVersion Include="Google.Cloud.Logging.Console" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup Label="Web">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <!-- Pinned to 2.x: Microsoft.AspNetCore.OpenApi 10.0.x is built against Microsoft.OpenApi 2.x.
         3.x makes IOpenApiMediaType.Example read-only, breaking the AspNetCore OpenAPI source generator. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="[2.12.0,3.0.0)" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>
  <ItemGroup Label="OIDC mock (local only)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.1" />
  </ItemGroup>
  <ItemGroup Label="Telemetry">
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.PostgreSQL.Extensions" Version="13.6.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Alba" Version="8.5.3" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.XunitV3" Version="4.15.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
