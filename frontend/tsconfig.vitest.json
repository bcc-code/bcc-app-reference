{
  "extends": "./tsconfig.app.json",
  "include": ["src/**/*.test.ts", "env.d.ts"],
  "exclude": [],
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node", "jsdom"],
    // Without `incremental`, `vue-tsc --build` keeps no per-file state and checks every file again on each run.
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
