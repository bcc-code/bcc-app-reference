{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 130,
  "singleQuote": true,
  "semi": false,
  "ignorePatterns": [
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    "dist",
    "playwright-report",
    "test-results",
    "pnpm-lock.yaml"
  ],
  "vueIndentScriptAndStyle": false,
  "endOfLine": "lf"
}
