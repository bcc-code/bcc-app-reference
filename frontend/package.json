{
  "name": "@bcc-template/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "lint": "oxlint . --deny-warnings && eslint . --cache --max-warnings 0",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "knip": "knip",
    "openapi-ts": "openapi-ts",
    "generate": "dotnet run --project ../api/BccCode.Template.Api -- jasper openapi --output BccCode.Template.Api.json && openapi-ts"
  },
  "dependencies": {
    "@bcc-code/component-library-vue": "^1.5.4",
    "@bcc-code/icons-vue": "^1.5.4",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/vue-query": "5.105.3",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tanstack/eslint-plugin-query": "^5.105.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.90.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "knip": "^6.44.1",
    "oxfmt": "^0.75.0",
    "oxlint": "~1.90.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.17.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24",
    "npm": "disallow",
    "pnpm": ">=11.0.0"
  },
  "//devEngines": "Exact pnpm version: pnpm writes its integrity hashes to pnpm-lock.yaml and checks them. No packageManager field. Keep in sync with .github/actions/setup/action.yml (pnpm/action-setup)."
}
