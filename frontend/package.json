{
  "name": "template-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "lint": "oxlint . && eslint . --cache",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "knip": "knip",
    "generate:api": "openapi-ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bcc-code/component-library-vue": "^1.4.39",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "5.104.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.60.0",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.87.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^27.0.0",
    "knip": "^6.40.0",
    "oxfmt": "^0.72.0",
    "oxlint": "~1.87.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26",
    "npm": "disallow",
    "pnpm": ">=12.11.2"
  }
}
