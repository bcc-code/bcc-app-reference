{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["vite.config.*", "eslint.config.*", "knip.config.*", "openapi-ts.config.*", "playwright.config.*", "e2e/**/*"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
