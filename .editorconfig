root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,yml,yaml,ts,vue,js,css,html}]
indent_size = 2

[*.cs]
max_line_length = 160

# Code style that the build enforces (EnforceCodeStyleInBuild), so it is a warning here, not a suggestion.
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_prefer_braces = when_multiline:silent
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_sort_system_directives_first = true

# IDE0005 only reports in the build when documentation generation is on, so it stays a suggestion.
dotnet_diagnostic.IDE0005.severity = suggestion

# CA1859 wants concrete parameter types for speed. Taking IConfiguration and IHostEnvironment keeps the methods testable.
dotnet_diagnostic.CA1859.severity = none

# CA1848 asks for LoggerMessage delegates; log classes with [LoggerMessage] are the rule here (see LoggingRulesTests).
dotnet_diagnostic.CA1848.severity = warning
# CA1707: test names are sentences with underscores (standard 19).
[api/tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

# EF Core writes these files; they are regenerated by `dotnet ef migrations add`, so style and analyzer rules do not apply.
[api/*/Migrations/**.cs]
generated_code = true
