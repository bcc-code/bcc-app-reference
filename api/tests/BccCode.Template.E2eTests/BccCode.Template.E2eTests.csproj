<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>
  <!-- The tests start the AppHost themselves, so it is not hosted as a resource. -->
  <ItemGroup>
    <ProjectReference Include="..\..\AppHost\AppHost.csproj" IsAspireProjectResource="false" />
  </ItemGroup>
  <!-- The personas are compiled in from the mock instead of referencing it: its OpenIddict packages would pull vulnerable
       transitive versions into a project that is not an ASP.NET Core app. -->
  <ItemGroup>
    <Compile Include="..\..\OidcMock\Personas.cs" Link="Infrastructure\Personas.cs" />
  </ItemGroup>
</Project>
