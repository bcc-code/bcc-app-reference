<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>
  <!-- The tests start the AppHost themselves, so it is not hosted as a resource. -->
  <ItemGroup>
    <ProjectReference Include="..\..\AppHost\AppHost.csproj" IsAspireProjectResource="false" />
  </ItemGroup>
  <!-- Build order only: the AppHost does not reference the services (it starts them by path), so without these the first test would
       wait for Aspire to compile them. -->
  <ItemGroup>
    <ProjectReference Include="..\..\BccCode.Template.Api\BccCode.Template.Api.csproj" IsAspireProjectResource="false" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\BccCode.Template.TestData\BccCode.Template.TestData.csproj" IsAspireProjectResource="false" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\OidcMock\OidcMock.csproj" IsAspireProjectResource="false" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- The personas are not compiled in here: the AppHost compiles them in from the mock (its OpenIddict packages would pull vulnerable
       transitive versions into a project that is not an ASP.NET Core app), and this project reaches them through its reference. -->
</Project>
