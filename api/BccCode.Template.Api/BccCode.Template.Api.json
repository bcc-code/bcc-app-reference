{
  "openapi": "3.2.0",
  "info": {
    "title": "Template API",
    "version": "v1"
  },
  "paths": {
    "/api/admin/stats": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "GET_api_admin_stats",
        "description": "getStats",
        "operationId": "GetStats",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStatsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "GET_api_me",
        "description": "getMe",
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/notes": {
      "post": {
        "tags": [
          "Notes"
        ],
        "summary": "POST_api_notes",
        "description": "createNote",
        "operationId": "CreateNote",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateNoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "GET_api_notes",
        "description": "listNotes",
        "operationId": "ListNotes",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListNotesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/notes/{noteId}": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "GET_api_notes_noteId",
        "description": "getNote",
        "operationId": "GetNote",
        "parameters": [
          {
            "name": "noteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNoteResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/notes/{noteId}/archive": {
      "post": {
        "tags": [
          "Notes"
        ],
        "summary": "POST_api_notes_noteId_archive",
        "description": "archiveNote",
        "operationId": "ArchiveNote",
        "parameters": [
          {
            "name": "noteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArchiveNoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/{noteId}/edit": {
      "post": {
        "tags": [
          "Notes"
        ],
        "summary": "POST_api_notes_noteId_edit",
        "description": "editNote",
        "operationId": "EditNote",
        "parameters": [
          {
            "name": "noteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditNoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditNoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/{noteId}/history": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "GET_api_notes_noteId_history",
        "description": "getNoteHistory",
        "operationId": "GetNoteHistory",
        "parameters": [
          {
            "name": "noteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNoteHistoryResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArchiveNoteRequest": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "description": "The version the client last read; a different stored version answers 409.",
            "format": "int32"
          },
          "comment": {
            "type": [
              "null",
              "string"
            ],
            "description": "Why the note is archived, if the person says; stored as the reason of the change."
          }
        }
      },
      "CreateNoteRequest": {
        "required": [
          "title",
          "body"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "1 to 200 characters, trimmed."
          },
          "body": {
            "type": "string",
            "description": "At most 10 000 characters, may be empty."
          }
        }
      },
      "CreateNoteResponse": {
        "required": [
          "id",
          "title",
          "body",
          "createdAt",
          "updatedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "EditNoteRequest": {
        "required": [
          "title",
          "body",
          "version"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The new title: 1 to 200 characters, trimmed."
          },
          "body": {
            "type": "string",
            "description": "The new body: at most 10 000 characters, may be empty."
          },
          "version": {
            "type": "integer",
            "description": "The version the client last read. A different stored version means someone else edited since, and the answer is 409.",
            "format": "int32"
          }
        }
      },
      "EditNoteResponse": {
        "required": [
          "id",
          "title",
          "body",
          "createdAt",
          "updatedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GetMeResponse": {
        "required": [
          "displayName",
          "roles"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "GetNoteHistoryResponse": {
        "required": [
          "id",
          "entries"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteHistoryItem"
            }
          }
        }
      },
      "GetNoteResponse": {
        "required": [
          "id",
          "title",
          "body",
          "createdAt",
          "updatedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GetStatsResponse": {
        "required": [
          "activeNotes",
          "archivedNotes"
        ],
        "type": "object",
        "properties": {
          "activeNotes": {
            "type": "integer",
            "format": "int32"
          },
          "archivedNotes": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ListNotesResponse": {
        "required": [
          "notes"
        ],
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NoteItem"
            }
          }
        }
      },
      "NoteHistoryItem": {
        "required": [
          "at",
          "step",
          "version",
          "title",
          "comment"
        ],
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "description": "When the step was taken.",
            "format": "date-time"
          },
          "step": {
            "type": "string",
            "description": "The business step: `NoteCreated`, `NoteEdited` or `NoteArchived`."
          },
          "version": {
            "type": "integer",
            "description": "The version of the note the step wrote.",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "description": "The note's title after the step, read from the version the step wrote."
          },
          "comment": {
            "type": [
              "null",
              "string"
            ],
            "description": "The reason the person gave for the step, if any."
          }
        }
      },
      "NoteItem": {
        "required": [
          "id",
          "title",
          "body",
          "createdAt",
          "updatedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Admin"
    },
    {
      "name": "Notes"
    },
    {
      "name": "Users"
    }
  ]
}