<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>BccCode.Template.Api</RootNamespace>
    <UserSecretsId>bcc-template-api</UserSecretsId>
    <ContainerRepository>bcc-template-api</ContainerRepository>
    <!-- ICU and tzdata. .NET 11 images are Ubuntu 26.04 "resolute"; there are no noble images. -->
    <ContainerFamily>resolute-chiseled-extra</ContainerFamily>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BccCode.Template.Tests" />
    <InternalsVisibleTo Include="BccCode.Template.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql" />
    <PackageReference Include="BccCode.PubSub.Wolverine" />
    <PackageReference Include="Google.Cloud.Kms.V1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Yarp" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="WolverineFx.Http" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.Pubsub" />
    <PackageReference Include="WolverineFx.Pubsub.Http" />
    <PackageReference Include="Yarp.ReverseProxy" />
    <!-- Design time only (dotnet ef migrations add): it must not flow into the image or into the test projects. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
    <ProjectReference Include="..\BccCode.Template\BccCode.Template.csproj" />
  </ItemGroup>
  <!-- Runtime compilation is Debug-only (#if DEBUG in WolverineConfiguration). The reference is unconditional so
       packages.lock.json is the same for every configuration (locked restore, NU1004); outside Debug its assets stay out. -->
  <ItemGroup>
    <PackageReference Include="WolverineFx.RuntimeCompilation">
      <ExcludeAssets Condition="'$(Configuration)' != 'Debug'">all</ExcludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
