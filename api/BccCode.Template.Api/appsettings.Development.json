{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Npgsql": "Warning", "Yarp": "Warning" } },
  "Oidc": { "ClientId": "template", "UseAuth0Logout": false },
  "Frontend": { "Mode": "Vite" },
  "ReverseProxy": {
    "Routes": {
      "frontend": { "ClusterId": "frontend", "Order": 1000, "Match": { "Path": "/{**catch-all}" } }
    },
    "Clusters": { "frontend": { "Destinations": { "vite": { "Address": "https+http://frontend" } } } }
  }
}
