<Project Sdk="Aspire.AppHost.Sdk/13.6.5">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>bcc-template-apphost</UserSecretsId>
    <IsPackable>false</IsPackable>
    <!-- ASPIRE010: the AppHost runs through dotnet run and the aspire.cli tool manifest, not the Aspire CLI bundle. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <!-- No ProjectReferences to the services: AddDotnetProject takes their paths, and Aspire builds them once when the app starts. A
       reference here only made the AppHost build compile them first. The E2E project holds build-order-only references instead. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.PostgreSQL.Extensions" />
  </ItemGroup>
</Project>
