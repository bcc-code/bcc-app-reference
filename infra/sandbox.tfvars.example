region            = "europe-west1"
environment       = "sandbox"
github_repository = "OWNER/REPO"
state_bucket      = "TODO-sandbox-tfstate-bucket"

oidc_authority = "https://TODO-oidc-provider.example.com"
oidc_client_id = "TODO-oidc-client-id-sandbox"

public_hostname  = "template.sandbox.example.com"
